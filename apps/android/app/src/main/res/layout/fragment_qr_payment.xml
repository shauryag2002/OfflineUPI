<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qr_tab_hint"
            android:textColor="@color/muted_silver"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_scan_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/button_scan_qr"
            app:backgroundTint="@color/graphite"
            app:cornerRadius="10dp"
            app:strokeColor="@color/ember_red"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_upload_gallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_upload_gallery"
            app:backgroundTint="@color/graphite"
            app:cornerRadius="10dp"
            app:strokeColor="@color/ember_red"
            app:strokeWidth="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_qr_amount"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxBackgroundColor="@color/graphite"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ember_red"
            app:hintTextColor="@color/muted_silver">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_qr_fallback_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/hint_qr_fallback_amount"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/smoke_white"
                android:textColorHint="@color/muted_silver" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/group_parsed_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/graphite"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/parsed_vpa"
                android:textColor="@color/muted_silver"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_parsed_vpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/smoke_white"
                android:textSize="14sp"
                tools:text="merchant@upi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/parsed_name"
                android:textColor="@color/muted_silver"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_parsed_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/smoke_white"
                android:textSize="14sp"
                tools:text="Offline Merchant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/parsed_amount"
                android:textColor="@color/muted_silver"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_parsed_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/smoke_white"
                android:textSize="14sp"
                tools:text="250" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_pay_scanned_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_pay_scanned_qr"
            app:backgroundTint="@color/ember_red"
            app:cornerRadius="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
